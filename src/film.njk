---
permalink: /film/
pageClass: film
pageTitle: Films
---
{%- for f in collections.filmsSorted %}
{%- set v = f.data.video | video -%}
{%- set laurels = f.data.laurels or [] -%}
<section class="film{% if not loop.first %} film-sep{% endif %}">
  {%- if f.data.heading or f.data.link_url %}
  <div class="film-heading">
    {%- if f.data.link_url %}<a class="pill" href="{{ f.data.link_url }}" rel="noopener">{{ f.data.link_label or "Learn more" }}</a>{% endif %}
    {%- if f.data.heading %}<h2>{{ f.data.heading }}</h2>{% endif %}
  </div>
  {%- endif %}
  <div class="film-grid{% if laurels.length %} has-laurels{% endif %}">
    <div class="film-video">
      {%- if v and v.type == "file" %}
      <video src="{{ v.embed }}" controls preload="metadata" playsinline></video>
      {%- elif v %}
      <iframe src="{{ v.embed }}" title="{{ f.data.title }}{% if f.data.year %} ({{ f.data.year }}){% endif %}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
      {%- endif %}
    </div>
    {%- for l in laurels %}{% if loop.index0 < 6 %}
    <span class="laurel-frame"><img class="laurel {{ 'side-l' if loop.index0 % 2 == 0 else 'side-r' }}" style="grid-row: {{ (loop.index0 // 2) + 1 }}" src="{{ l | img('thumb') }}" alt="Festival laurel for {{ f.data.title }}" loading="lazy"></span>
    {%- endif %}{% endfor %}
  </div>
  {%- if laurels.length > 6 %}
  <div class="laurel-row{% if laurels.length == 13 %} laurel-row-7{% endif %}">
    {%- for l in laurels %}{% if loop.index0 >= 6 %}<span class="laurel-frame"><img class="laurel" src="{{ l | img('thumb') }}" alt="Festival laurel for {{ f.data.title }}" loading="lazy"></span>{% endif %}{% endfor %}
  </div>
  {%- endif %}
</section>
{%- endfor %}
