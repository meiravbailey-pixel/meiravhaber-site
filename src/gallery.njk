---
pagination:
  data: categories
  size: 1
  alias: cat
permalink: "{{ cat.url }}"
pageClass: gallery
scripts: [lightbox.js]
eleventyComputed:
  pageTitle: "{{ cat.label }}"
---
{%- set items = collections.projectsSorted | inCategory(cat.key) -%}
<section class="panel gallery-panel">
  <h1 class="page-title">{{ cat.label }}</h1>
  {% include "gallery-grid.njk" %}
</section>
